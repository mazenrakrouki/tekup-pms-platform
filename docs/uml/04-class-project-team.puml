@startuml class_project_team
title Classes — Project and Team

top to bottom direction

skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C5F8A
skinparam classHeaderBackgroundColor #D6E4F0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1.5
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7
hide circle
hide empty methods

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  --
  + canTransitionTo(target) : boolean
}

class Project {
  - code : String
  - name : String
  - client : String
  - status : ProjectStatus
  - initialBudget : BigDecimal
  - revisedBudget : BigDecimal
  - currency : String
  - soldWorkloadDays : BigDecimal
  - archived : boolean
  --
  + getEffectiveBudget() : BigDecimal
}

class User {
  - firstName : String
  - lastName : String
  - email : String
}

class TeamAssignment {
  - roleInTeam : String
  - startDate : LocalDate
  - endDate : LocalDate
}

class Resource {
  - dailyRate : BigDecimal
  - tccRate : BigDecimal
}

Project ..> ProjectStatus
Project "*" --> "1" User : director >
Project "*" --> "0..1" User : project manager >
Project "1" *-- "*" TeamAssignment
TeamAssignment "*" --> "1" User : member >
Resource "0..1" --> "1" User : cost of >

note right of Project
  Effective budget = revisedBudget if set, otherwise initialBudget.
end note

note bottom of ProjectStatus
  Any illegal transition is rejected (HTTP 422).
end note

@enduml
