@startuml class_project_team
title Classes — Project and Team

top to bottom direction

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
skinparam class {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  FontStyle             plain
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam enum {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam ArrowColor      #1A1A1A
skinparam ArrowThickness  1.4
skinparam ArrowFontColor  #4A5BBF
skinparam ArrowFontStyle  italic
skinparam ArrowFontName   Courier
skinparam ArrowFontSize   12
skinparam TitleFontName   Courier
skinparam TitleFontSize   16
skinparam TitleFontColor  #1A1A1A
skinparam noteBorderColor     #B9A0D4
skinparam noteBackgroundColor #F6F1FB
skinparam noteFontName        Courier
skinparam noteFontSize        11
hide circle
hide empty methods

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  --
  + canTransitionTo(target) : boolean
}

class Project {
  - code : String
  - name : String
  - client : String
  - status : ProjectStatus
  - initialBudget : BigDecimal
  - revisedBudget : BigDecimal
  - currency : String
  - soldWorkloadDays : BigDecimal
  - archived : boolean
  --
  + getEffectiveBudget() : BigDecimal
}

class User {
  - firstName : String
  - lastName : String
  - email : String
}

class TeamAssignment {
  - roleInTeam : String
  - startDate : LocalDate
  - endDate : LocalDate
}

class Resource {
  - dailyRate : BigDecimal
  - tccRate : BigDecimal
}

Project ..> ProjectStatus
Project "*" --> "1" User : director >
Project "*" --> "0..1" User : project manager >
Project "1" *-- "*" TeamAssignment
TeamAssignment "*" --> "1" User : member >
Resource "0..1" --> "1" User : cost of >

note right of Project
  Effective budget = revisedBudget if set, otherwise initialBudget.
end note

note bottom of ProjectStatus
  Any illegal transition is rejected (HTTP 422).
end note

@enduml
