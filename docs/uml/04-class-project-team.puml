@startuml class_project_team
title Classes — Gestion de Projet et Équipe

top to bottom direction

skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C5F8A
skinparam classHeaderBackgroundColor #D6E4F0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1.5
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7
hide circle

enum StatutProjet {
  BROUILLON
  ACTIF
  EN_ATTENTE
  TERMINE
  ANNULE
}

class Projet {
  - code : String
  - nom : String
  - client : String
  - budget : double
  - typeEngagement : String
  - dateDebut : Date
  - dateFin : Date
  --
  + assignerChefDeProjet(chef : Utilisateur) : void
  + ajouterMembre(ressource : Ressource) : void
  + calculerBudgetRestant() : double
}

class Utilisateur {
  - nom : String
  - prenom : String
  - email : String
}

class Ressource {
  - nomComplet : String
  - profil : String
  --
  + calculerCoutAnnuel(annee : int) : double
}

class AffectationEquipe {
  - tauxAffectation : double
  - dateDebut : Date
  - dateFin : Date
}

class Livrable {
  - designation : String
  - livre : boolean
  - dateLivraison : Date
  --
  + marquerLivre() : void
}

Projet "*"  --> "1"    Utilisateur       : directeur >
Projet "*"  --> "1..*" Utilisateur       : chefs de projet >
Projet "1"  *-- "*"    AffectationEquipe
AffectationEquipe "*" --> "1" Ressource  : concerne >
Projet "1"  *-- "*"    Livrable
Projet      -->         StatutProjet      : statut >

note right of AffectationEquipe
  Affectation partielle possible :
  ex. un développeur à 50 %
  sur deux projets simultanément.
end note

@enduml
