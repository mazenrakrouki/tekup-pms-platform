@startuml seq_login
title Sequence — Authentication

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #808080
skinparam participantBackgroundColor #FFFFFF
skinparam participantBorderColor #808080
skinparam databaseBackgroundColor #FFFFFF
skinparam databaseBorderColor #808080
skinparam sequenceGroupBackgroundColor #FFFFFF
skinparam sequenceGroupBorderColor #808080
skinparam sequenceReferenceBackgroundColor #FFFFFF
skinparam sequenceParticipantBorderColor #808080
skinparam sequenceLifeLineBorderColor #AAAAAA
skinparam ArrowColor #333333
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FAFAFA
autonumber

actor "User" as U
participant "Frontend\n(Angular)" as SPA
participant "AuthController" as AC
participant "AuthService" as AS
database "PostgreSQL" as DB

U -> SPA : email + password
SPA -> AC : POST /api/auth/login
AC -> AS : login(credentials)
AS -> AS : rate limiter\n(5 / 15 min, constant time)
AS -> DB : active user + role + permissions
DB --> AS : user
AS --> AC : access token (JWT)\n+ refresh token
AC --> SPA : 200 + access token\nSet-Cookie refresh (HttpOnly, Strict)

alt first login
  SPA --> U : forced password change\n(all other routes blocked server-side)
else normal login
  SPA --> U : role-based dashboard
end

note over AS, DB
  The refresh token is single-use: each refresh increments tokenVersion (replay detection).
end note

@enduml
