@startuml seq_assign_developer
title Séquence — Affecter un Développeur à un Projet

autonumber

skinparam shadowing false
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBackgroundColor #D6E4F0
skinparam sequenceParticipantBorderColor #2C5F8A
skinparam sequenceActorBackgroundColor #FAFAFA
skinparam sequenceActorBorderColor #2C5F8A
skinparam sequenceGroupBackgroundColor #F0F8FF
skinparam sequenceGroupBorderColor #2C5F8A
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12

actor      "Chef de Projet\nou Directeur" as Acteur
participant "Interface Web"               as UI
participant "Service de gestion d'équipe" as TEAM
participant "Service de droits d'accès"   as SEC
participant "Base de données"             as DB

Acteur -> UI   : sélectionner le développeur\net définir son taux d'affectation
UI     -> TEAM : affecter(projetId, développeurId, tauxAffectation)

TEAM -> SEC : vérifier permission AFFECTER_DEVELOPPEUR
alt non autorisé
  SEC  --> TEAM : refus
  TEAM --> UI   : accès refusé
  UI   --> Acteur : message d'erreur

else permission accordée
  TEAM -> SEC : vérifier l'accès au projet
  note right of SEC : Directeur → tous les projets.\nChef de Projet → ses projets uniquement.

  alt projet inaccessible
    SEC  --> TEAM : refus de portée
    TEAM --> UI   : projet inaccessible
    UI   --> Acteur : message d'erreur

  else accès autorisé
    TEAM -> DB   : enregistrer l'affectation
    DB   --> TEAM : confirmation
    TEAM --> UI  : affectation enregistrée
    UI   --> Acteur : développeur ajouté à l'équipe
  end
end

@enduml
