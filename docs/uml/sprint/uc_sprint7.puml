@startuml uc_sprint7
' NOTE: this source is no longer what the report prints. GraphViz routes
' every edge itself, so an actor's association came out curved, or under
' linetype polyline as straight segments with a corner in them. The figure
' is now laid out by hand and generated by docs/figures/gen_drawio_usecase.py.
' Kept as the readable model of the diagram: change both, or they drift.
title Sprint 7 — Project governance

left to right direction

skinparam linetype polyline

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam actorBorderColor #808080
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #808080
skinparam usecaseBackgroundColor #FFFFFF
skinparam ArrowColor #333333
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FAFAFA
skinparam TitleFontSize 13
skinparam TitleFontColor #333333

actor "Director\n(DIRECTEUR)"          as Dir
actor "Project Manager\n(CHEF_PROJET)" as PM

rectangle "PMS Platform" {
  usecase "Maintain the\nrisk register" as UC1
  usecase "Track the\ndeliverables" as UC2
  usecase "Document the\nstakeholders" as UC3
  usecase "Handle change\nrequests" as UC4
  usecase "Consult the\nregisters" as UC5
  usecase "Authenticate" as UC0
}

PM -- UC1
PM -- UC2
PM -- UC3
PM -- UC4
Dir -- UC5
UC1 ..> UC0 : <<include>>
UC2 ..> UC0 : <<include>>
UC3 ..> UC0 : <<include>>
UC4 ..> UC0 : <<include>>
UC5 ..> UC0 : <<include>>

note right of UC2
  The deliverable status is controlled, not free text:
  the delivery rate of Sprint 8 is derived from it.
end note

@enduml
