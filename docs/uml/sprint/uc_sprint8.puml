@startuml uc_sprint8
title Sprint 8 — Internal quote and indicator engine

left to right direction

skinparam linetype polyline

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam actorBorderColor #808080
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #808080
skinparam usecaseBackgroundColor #FFFFFF
skinparam ArrowColor #333333
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FAFAFA
skinparam TitleFontSize 13
skinparam TitleFontColor #333333

actor "Director\n(DIRECTEUR)"          as Dir
actor "Project Manager\n(CHEF_PROJET)" as PM

rectangle "PMS Platform" {
  usecase "Define the\ninternal quote" as UC1
  usecase "Consult the computed\nindicators" as UC2
  usecase "Freeze the\nmonthly review" as UC3
  usecase "Consult the portfolio\ndashboard" as UC4
  usecase "Authenticate" as UC0
}

Dir -- UC1
Dir -- UC2
Dir -- UC4
PM -- UC2
PM -- UC3
UC3 ..> UC2 : <<extend>>
UC1 ..> UC0 : <<include>>
UC2 ..> UC0 : <<include>>
UC4 ..> UC0 : <<include>>

note right of UC1
  Restricted access: unit costs and internal margins
  are the most commercially sensitive data held.
end note

@enduml
