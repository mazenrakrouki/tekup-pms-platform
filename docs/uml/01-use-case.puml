@startuml use_case
title Global Use Case Diagram --- PMS Platform

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam actorBorderColor #808080
skinparam actorBackgroundColor #FFFFFF
skinparam usecaseBorderColor #808080
skinparam usecaseBackgroundColor #FFFFFF
skinparam ArrowColor #333333
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FAFAFA
skinparam TitleFontSize 13
skinparam TitleFontColor #333333

actor "Administrator\n(ADMIN)"         as Admin
actor "Director\n(DIRECTEUR)"          as Dir
actor "Project Manager\n(CHEF_PROJET)" as PM
actor "Developer\n(DEVELOPPEUR)"       as Dev

rectangle "PMS Platform" {

  usecase "Manage users\nand access rights"     as UC1
  usecase "Manage resources\nand cost rates"    as UC2
  usecase "Manage projects"                     as UC3
  usecase "Define the\ninternal quote"          as UC4
  usecase "Manage project\nexecution"           as UC5
  usecase "Record own\nworkload"                as UC6
  usecase "Manage financial\ntracking"          as UC7
  usecase "Manage project\ngovernance"          as UC8
  usecase "Monitor performance\nindicators"     as UC9

  usecase "Freeze the\nmonthly review"          as UC10
  usecase "Authenticate"                        as AUTH
}

Admin --> UC1
Admin --> UC2

Dir --> UC3
Dir --> UC4
Dir --> UC5
Dir --> UC9

PM  --> UC5
PM  --> UC7
PM  --> UC8
PM  --> UC9

Dev --> UC6
Dev --> UC9

UC1 ..> AUTH : <<include>>
UC2 ..> AUTH : <<include>>
UC3 ..> AUTH : <<include>>
UC4 ..> AUTH : <<include>>
UC5 ..> AUTH : <<include>>
UC6 ..> AUTH : <<include>>
UC7 ..> AUTH : <<include>>
UC8 ..> AUTH : <<include>>
UC9 ..> AUTH : <<include>>

UC9 <.. UC10 : <<extend>>

note right of UC4
  Restricted access: sensitive commercial data.
end note

@enduml
