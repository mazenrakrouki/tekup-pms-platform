@startuml class_agile
title Classes — Agile Planning (product backlog and sprints)

top to bottom direction

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 80
skinparam class {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  FontStyle             plain
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam enum {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam ArrowColor      #1A1A1A
skinparam ArrowThickness  1.4
skinparam ArrowFontColor  #4A5BBF
skinparam ArrowFontStyle  italic
skinparam ArrowFontName   Courier
skinparam ArrowFontSize   12
skinparam TitleFontName   Courier
skinparam TitleFontSize   16
skinparam TitleFontColor  #1A1A1A
skinparam noteBorderColor     #B9A0D4
skinparam noteBackgroundColor #F6F1FB
skinparam noteFontName        Courier
skinparam noteFontSize        11
hide circle
hide empty methods

class Project {
  - code : String
  - name : String
}

class Sprint {
  - name : String
  - goal : String
  - startDate : LocalDate
  - endDate : LocalDate
  - status : SprintStatus
}

class BacklogItem {
  - title : String
  - description : String
  - priority : BacklogPriority
  - estimateDays : BigDecimal
  - status : BacklogItemStatus
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum BacklogPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BacklogItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

Project "1" *-- "0..*" Sprint      : plans >
Project "1" *-- "0..*" BacklogItem : owns >
Sprint  "0..1" o-- "0..*" BacklogItem : commits >

Sprint      .right.> SprintStatus
BacklogItem .right.> BacklogItemStatus
BacklogItem .down.>  BacklogPriority

note bottom of BacklogItem
  A null sprint means the item is
  still in the product backlog.
end note

note top of Sprint
  Aggregation: deleting a sprint
  returns its items to the backlog.
end note

@enduml
