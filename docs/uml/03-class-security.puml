@startuml class_security
title Classes — Security and Access Control (dynamic RBAC)

left to right direction

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
skinparam class {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  FontStyle             plain
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam enum {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam ArrowColor      #1A1A1A
skinparam ArrowThickness  1.4
skinparam ArrowFontColor  #4A5BBF
skinparam ArrowFontStyle  italic
skinparam ArrowFontName   Courier
skinparam ArrowFontSize   12
skinparam TitleFontName   Courier
skinparam TitleFontSize   16
skinparam TitleFontColor  #1A1A1A
skinparam noteBorderColor     #B9A0D4
skinparam noteBackgroundColor #F6F1FB
skinparam noteFontName        Courier
skinparam noteFontSize        11
hide circle
hide empty methods

class User {
  - email : String
  - active : boolean
  - firstLogin : boolean
  - tokenVersion : int
}

class Role {
  - name : String
}

class Permission {
  - code : String
  - module : String
}

User "*" --> "1" Role : has >
Role "*" -- "*" Permission : grants >

note bottom of User
  Incrementing tokenVersion revokes all active sessions.
end note

note bottom of Permission
  The role→permission matrix is stored in the database, not hardcoded.
end note

@enduml
