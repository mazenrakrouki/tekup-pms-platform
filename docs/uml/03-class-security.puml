@startuml class_security
title Classes — Security and Access Control (dynamic RBAC)

left to right direction

skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C5F8A
skinparam classHeaderBackgroundColor #D6E4F0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1.5
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7
hide circle
hide empty methods

class User {
  - email : String
  - active : boolean
  - firstLogin : boolean
  - tokenVersion : int
}

class Role {
  - name : String
}

class Permission {
  - code : String
  - module : String
}

User "*" --> "1" Role : has >
Role "*" -- "*" Permission : grants >

note bottom of User
  Incrementing tokenVersion revokes all active sessions.
end note

note bottom of Permission
  The role→permission matrix is stored in the database, not hardcoded.
end note

@enduml
