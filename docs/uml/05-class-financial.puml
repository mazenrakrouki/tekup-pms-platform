@startuml class_financial
title Classes — Financial Management (billing, amendments, Internal Quote)

top to bottom direction

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
skinparam class {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  FontStyle             plain
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam enum {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam ArrowColor      #1A1A1A
skinparam ArrowThickness  1.4
skinparam ArrowFontColor  #4A5BBF
skinparam ArrowFontStyle  italic
skinparam ArrowFontName   Courier
skinparam ArrowFontSize   12
skinparam TitleFontName   Courier
skinparam TitleFontSize   16
skinparam TitleFontColor  #1A1A1A
skinparam noteBorderColor     #B9A0D4
skinparam noteBackgroundColor #F6F1FB
skinparam noteFontName        Courier
skinparam noteFontSize        11
hide circle
hide empty methods

class Project {
  - code : String
  - currency : String
  - exchangeRateToTnd : BigDecimal
}

enum MilestoneStatus {
  PLANNED
  INVOICED
  PAID
}

class BillingMilestone {
  - label : String
  - percentage : BigDecimal
  - amount : BigDecimal
  - dueDate : LocalDate
  - status : MilestoneStatus
}

class Payment {
  - amountReceived : BigDecimal
  - paymentDate : LocalDate
  - reference : String
}

class Amendment {
  - number : String
  - subject : String
  - amount : BigDecimal
  - workloadDays : BigDecimal
}

enum QuoteSection {
  FEES
  EXPENSES
  OTHER_EXPENSES
}

class QuoteLine {
  - section : QuoteSection
  - contractProfile : String
  - soldWorkloadDays : BigDecimal
  - unitSellingPrice : BigDecimal
  - internalWorkloadDays : BigDecimal
  - unitTccCost : BigDecimal
  - percentageRate : BigDecimal
}

class Mission {
  - purpose : String
  - location : String
  - startDate : LocalDate
  - endDate : LocalDate
}

Project "1" *-- "*" BillingMilestone : milestones >
BillingMilestone "1" *-- "*" Payment : payments >
BillingMilestone ..> MilestoneStatus
Project "1" *-- "*" Amendment : amendments >
Project "1" *-- "*" QuoteLine : internal quote >
QuoteLine ..> QuoteSection
Project "1" *-- "*" Mission : missions >

note right of BillingMilestone
  The sum of milestone percentages does not exceed 100% of the contract.
end note

note bottom of QuoteLine
  Amounts and margins are always computed at read time, never stored.
end note

@enduml
