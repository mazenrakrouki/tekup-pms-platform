@startuml class_financial
title Classes — Financial Management (billing, amendments, Internal Quote)

top to bottom direction

skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2C5F8A
skinparam classHeaderBackgroundColor #D6E4F0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1.5
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7
hide circle
hide empty methods

class Project {
  - code : String
  - currency : String
  - exchangeRateToTnd : BigDecimal
}

enum MilestoneStatus {
  PLANNED
  INVOICED
  PAID
}

class BillingMilestone {
  - label : String
  - percentage : BigDecimal
  - amount : BigDecimal
  - dueDate : LocalDate
  - status : MilestoneStatus
}

class Payment {
  - amountReceived : BigDecimal
  - paymentDate : LocalDate
  - reference : String
}

class Amendment {
  - number : String
  - subject : String
  - amount : BigDecimal
  - workloadDays : BigDecimal
}

enum QuoteSection {
  FEES
  EXPENSES
  OTHER_EXPENSES
}

class QuoteLine {
  - section : QuoteSection
  - contractProfile : String
  - soldWorkloadDays : BigDecimal
  - unitSellingPrice : BigDecimal
  - internalWorkloadDays : BigDecimal
  - unitTccCost : BigDecimal
  - percentageRate : BigDecimal
}

class Mission {
  - purpose : String
  - location : String
  - startDate : LocalDate
  - endDate : LocalDate
}

Project "1" *-- "*" BillingMilestone : milestones >
BillingMilestone "1" *-- "*" Payment : payments >
BillingMilestone ..> MilestoneStatus
Project "1" *-- "*" Amendment : amendments >
Project "1" *-- "*" QuoteLine : internal quote >
QuoteLine ..> QuoteSection
Project "1" *-- "*" Mission : missions >

note right of BillingMilestone
  The sum of milestone percentages does not exceed 100% of the contract.
end note

note bottom of QuoteLine
  Amounts and margins are always computed at read time, never stored.
end note

@enduml
