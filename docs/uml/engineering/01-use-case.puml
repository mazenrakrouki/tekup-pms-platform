@startuml use_case
title Use Case Diagram — PMS Platform

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorBackgroundColor #D6E4F0
skinparam actorBorderColor #2C5F8A
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #2C5F8A
skinparam usecaseFontSize 12
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7

actor "Administrator"        as Admin
actor "Director"             as Dir
actor "Project Manager"      as PM
actor "Developer"            as Dev
actor "KIMAI\n(external system)" as Kimai

rectangle "PMS Platform" {

  usecase "Manage users and rights"                        as UC3
  usecase "Create and configure a project"                 as UC4
  usecase "Assign the project manager"                     as UC_PM
  usecase "Build the project team"                         as UC5
  usecase "Authenticate\n(password change\non first login)" as UC1
  usecase "Plan the workload"                               as UC6
  usecase "Manage billing and milestones"                   as UC7
  usecase "Manage risks and deliverables"                   as UC8
  usecase "View KPIs and dashboards"                        as UC11
  usecase "Submit actual workload"                          as UC9
  usecase "Import workload (KIMAI)"                         as UC10

}

Admin --> UC3
Admin --> UC1

Dir --> UC1
Dir --> UC4
Dir --> UC_PM
Dir --> UC5
Dir --> UC11

PM  --> UC1
PM  --> UC5
PM  --> UC6
PM  --> UC7
PM  --> UC8
PM  --> UC11

Dev --> UC1
Dev --> UC9
Dev --> UC11

Kimai --> UC10

note right of UC11
  Role-based view: Director → full portfolio, Project Manager → own projects, Developer → own assignments.
end note

note right of UC5
  Director and Project Manager share this capability.
end note

@enduml
