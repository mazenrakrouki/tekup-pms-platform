@startuml seq_assign_developer
title Sequence: Assign a Developer to a Project

autonumber

skinparam shadowing false
skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBackgroundColor #D6E4F0
skinparam sequenceParticipantBorderColor #2C5F8A
skinparam sequenceActorBackgroundColor #FAFAFA
skinparam sequenceActorBorderColor #2C5F8A
skinparam sequenceGroupBackgroundColor #F0F8FF
skinparam sequenceGroupBorderColor #2C5F8A
skinparam noteBorderColor #999999
skinparam noteBackgroundColor #FFFDE7
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12

actor      "Project Manager\nor Director" as Actor
participant "Web Interface"               as UI
participant "Team Service"                as TEAM
participant "Access Rights Service"       as SEC
participant "Database"                    as DB

Actor -> UI   : select the developer and set their allocation rate
UI    -> TEAM : assign(projectId, developerId, allocationRate)

TEAM -> SEC : does the user hold the ASSIGN_DEVELOPER permission?
alt missing permission
  SEC --> TEAM : access denied
  TEAM --> UI  : 403 error
  UI --> Actor : access-denied message

else permission granted
  SEC  --> TEAM : permission verified

  TEAM -> SEC : does the user have access to this project?
  note right of SEC : Director → access to all projects.\nProject Manager → own projects only.

  alt project out of scope
    SEC  --> TEAM : scope denied
    TEAM --> UI   : 403 error
    UI --> Actor : project not accessible

  else access authorized
    SEC  --> TEAM : scope verified
    TEAM -> DB   : record the assignment\n(developer, project, rate, start date)
    DB   --> TEAM : assignment recorded
    TEAM --> UI  : success
    UI   --> Actor : developer added to the team

  end
end

@enduml
