@startuml class_governance
title Classes — Project Governance

top to bottom direction

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
skinparam class {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  FontStyle             plain
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam enum {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam ArrowColor      #1A1A1A
skinparam ArrowThickness  1.4
skinparam ArrowFontColor  #4A5BBF
skinparam ArrowFontStyle  italic
skinparam ArrowFontName   Courier
skinparam ArrowFontSize   12
skinparam TitleFontName   Courier
skinparam TitleFontSize   16
skinparam TitleFontColor  #1A1A1A
skinparam noteBorderColor     #B9A0D4
skinparam noteBackgroundColor #F6F1FB
skinparam noteFontName        Courier
skinparam noteFontSize        11
hide circle
hide empty methods

class Project {
  - code : String
  - name : String
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

class Risk {
  - description : String
  - probability : RiskLevel
  - impact : RiskLevel
  - status : RiskStatus
  - mitigationPlan : String
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

class Deliverable {
  - title : String
  - dueDate : LocalDate
  - status : DeliverableStatus
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  VALIDATED
}

class ChangeRequest {
  - title : String
  - priority : ChangePriority
  - status : ChangeStatus
  - requestDate : LocalDate
  - decisionDate : LocalDate
}

enum ChangePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

class Stakeholder {
  - name : String
  - role : String
  - influence : RiskLevel
}

Project "1" *-- "*" Risk
Project "1" *-- "*" Deliverable
Project "1" *-- "*" ChangeRequest
Project "1" *-- "*" Stakeholder
Risk ..> RiskLevel : probability, impact
Risk ..> RiskStatus
Deliverable ..> DeliverableStatus
ChangeRequest ..> ChangePriority
ChangeRequest ..> ChangeStatus
Stakeholder ..> RiskLevel

note right of Deliverable
  EVM Delivery % = delivered/validated deliverables ÷ planned deliverables × 100.
end note

@enduml
