@startuml package_diagram
title Modular Architecture — The 10 Real Backend Packages (com.pms.*)

skinparam shadowing false
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FAFAFA
skinparam packageBorderColor #808080
skinparam packageFontColor #808080
skinparam packageFontSize 13
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ArrowThickness 1.5

package "auth\nJWT, RBAC, sessions"                    as AUTH
package "user\nusers, resources,\nyearly TCC"           as USER
package "project\nprojects, status,\nInternal Quote"    as PROJ
package "team\nteam assignments"                        as TEAM
package "workload\nworkload plan,\nactual workload"     as WORK
package "billing\nmilestones, payments,\namendments"    as BILL
package "mission\nmissions and expenses"                as MISS
package "governance\nrisks, deliverables,\nchanges"     as GOV
package "kpi\nEVM engine:\nlive calc + snapshots"       as KPI
package "shared\nconfig, web security,\nexceptions"     as SHARED

USER ..> AUTH : depends on
PROJ ..> USER : depends on
TEAM ..> PROJ : depends on
TEAM ..> USER : depends on
WORK ..> TEAM : depends on
BILL ..> PROJ : depends on
MISS ..> PROJ : depends on
GOV  ..> PROJ : depends on

KPI <.. WORK : feeds
KPI <.. BILL : feeds
KPI <.. USER : yearly TCC
KPI <.. PROJ : Internal Quote, budget

AUTH ..> SHARED
PROJ ..> SHARED

@enduml
