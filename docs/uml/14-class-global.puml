@startuml class_global
title Classes — Domain Overview (global map, details in diagrams 3 to 7)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 55
skinparam ranksep 65
skinparam class {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  FontStyle             plain
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam enum {
  BackgroundColor       #FFFFFF
  BorderColor           #6B2FA0
  BorderThickness       1.4
  HeaderBackgroundColor #6B2FA0
  FontColor             #FFFFFF
  FontName              Courier
  FontSize              15
  AttributeFontColor    #1A1A1A
  AttributeFontName     Courier
  AttributeFontSize     13
}
skinparam packageStyle           rectangle
skinparam packageBackgroundColor #FBF9FE
skinparam packageBorderColor     #6B2FA0
skinparam packageFontColor       #4B1E77
skinparam packageFontName        Courier
skinparam ArrowColor      #1A1A1A
skinparam ArrowThickness  1.4
skinparam ArrowFontColor  #4A5BBF
skinparam ArrowFontStyle  italic
skinparam ArrowFontName   Courier
skinparam ArrowFontSize   12
skinparam TitleFontName   Courier
skinparam TitleFontSize   16
skinparam TitleFontColor  #1A1A1A
skinparam noteBorderColor     #B9A0D4
skinparam noteBackgroundColor #F6F1FB
skinparam noteFontName        Courier
skinparam noteFontSize        11
hide circle
hide empty methods
hide members

package "Security" {
  class User
  class Role
  class Permission
}

package "Resources & Costs" {
  class Resource
  class AnnualTcc
}

package "Project & Team" {
  class Project
  class TeamAssignment
}

package "Workload" {
  class WorkloadPlan
  class ActualWorkload
}

package "Financial" {
  class QuoteLine
  class Amendment
  class BillingMilestone
  class Payment
  class Mission
}

package "Governance" {
  class Risk
  class Deliverable
  class ChangeRequest
  class Stakeholder
}

package "KPI" {
  class KpiSnapshot
}

' -- Security --
User "*" --> "1" Role
Role "*" -- "*" Permission

' -- Resources --
Resource "0..1" --> "1" User
Resource "1" *-- "*" AnnualTcc

' -- Project & Team --
Project "*" --> "1" User : director
Project "*" --> "0..1" User : project manager
Project "1" *-- "*" TeamAssignment
TeamAssignment "*" --> "1" User

' -- Workload --
Project "1" *-- "*" WorkloadPlan
Project "1" *-- "*" ActualWorkload

' -- Financial --
Project "1" *-- "*" QuoteLine
Project "1" *-- "*" Amendment
Project "1" *-- "*" BillingMilestone
BillingMilestone "1" *-- "*" Payment
Project "1" *-- "*" Mission

' -- Governance --
Project "1" *-- "*" Risk
Project "1" *-- "*" Deliverable
Project "1" *-- "*" ChangeRequest
Project "1" *-- "*" Stakeholder

' -- KPI --
Project "1" *-- "*" KpiSnapshot

' -- Layout (invisible links: keep the map to 2 rows of packages) --
TeamAssignment -[hidden]down- WorkloadPlan
AnnualTcc -[hidden]down- QuoteLine
Permission -[hidden]down- Amendment
Mission -[hidden]right- Risk
ChangeRequest -[hidden]right- KpiSnapshot

note bottom of ActualWorkload
  WorkloadPlan and ActualWorkload also reference the concerned user.
end note

note right of Project
  The project is the aggregation root of the domain.
end note

@enduml
