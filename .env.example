# ─────────────────────────────────────────────────────────────────
# PMS — gabarit de configuration Docker Compose
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (bash)
#
# .env est ignoré par git ; ce gabarit est versionné.
# Voir docs/DEPLOYMENT.md pour la procédure complète.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────
DB_NAME=pms
DB_USERNAME=pms
DB_PASSWORD=change-me-before-first-run

# ── Ports hôte ───────────────────────────────────────────────────
# Choisis pour ne pas entrer en conflit avec l'environnement de développement :
#   5432 = service PostgreSQL 17 natif
#   8090 = mvn spring-boot:run (profil dev)
#   4200 = ng serve
#   8080 = Apache httpd
DB_HOST_PORT=5433
BACKEND_HOST_PORT=8091
FRONTEND_HOST_PORT=8081

# ── Secrets ──────────────────────────────────────────────────────
# ATTENTION : la valeur est utilisée telle quelle (octets UTF-8 bruts) pour
# signer les jetons en HMAC-SHA512. Elle doit donc faire AU MOINS 64 CARACTÈRES.
# Ce n'est PAS une valeur base64 qui serait décodée.
#
# Générer une clé :
#   PowerShell : $b=New-Object byte[] 64; `
#     [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); `
#     [Convert]::ToBase64String($b)
#   Git Bash   : openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=REPLACE_ME_WITH_AT_LEAST_64_CHARACTERS_0123456789_0123456789_0123456789

# ── Exécution ────────────────────────────────────────────────────
COOKIE_SECURE=false                        # true uniquement derrière HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:8081
LOG_ROOT_LEVEL=INFO                        # WARN une fois la pile stabilisée

# Comptes de démonstration aux mots de passe connus (voir docs/DEPLOYMENT.md §5).
# Actifs par défaut pour que la pile soit démontrable immédiatement.
# METTRE À false POUR TOUT DÉPLOIEMENT RÉEL.
PMS_DEMO_SEED_USERS=true
TZ=Africa/Tunis
IMAGE_TAG=local
