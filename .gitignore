# ── Maven / Spring Boot ───────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
# NOTE: .mvn/ is intentionally NOT ignored — the Maven wrapper (mvnw, mvnw.cmd,
# .mvn/wrapper/) must be committed so a CI runner can build without a preinstalled Maven.

# ── Angular / Node ────────────────────────────────────────────────
frontend/pms-frontend/node_modules/
frontend/pms-frontend/dist/
frontend/pms-frontend/.angular/
frontend/pms-frontend/*.js.map

# ── IDE ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.classpath
.project
.settings/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Variables d'environnement ─────────────────────────────────────
.env
.env.*
*.env
# Le gabarit doit être versionné (négation APRÈS les règles ci-dessus).
!.env.example

# ── Sauvegardes base de données ───────────────────────────────────
/backups/

# ── Logs ──────────────────────────────────────────────────────────
*.log
*.log.err
logs/

# ── Rapports de test ──────────────────────────────────────────────
/backend/target/surefire-reports/

# ── Artefacts LaTeX ───────────────────────────────────────────────
*.aux
*.idx
*.lof
*.lot
*.mtc
*.mtc[0-9]*
*.maf
*.toc
*.run.xml
*.blg
*.bbl
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
_build_*

# Sauvegardes locales (ne jamais versionner)
*.bak
*.bak-*

# Python caches (scripts de generation des figures)
__pycache__/
*.pyc
